# Скопируйте значения в Vercel → Project → Settings → Environment Variables.
# Реальные ключи в репозиторий не коммитить.

# Ключ карты 2ГИС (MapGL). Используется в браузере.
NEXT_PUBLIC_2GIS_MAP_KEY=your_demo_key_here

# Ключ 2ГИС для поиска и маршрутов (Catalog API, Routing API, Public Transport API).
# Используется только на сервере. Если не задан, берётся NEXT_PUBLIC_2GIS_MAP_KEY.
TWOGIS_API_KEY=

# Supabase (аккаунты и синхронизация между устройствами). Необязательно для начала.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
